# FinanFlow — copy to .env and adjust.
# Never commit a real .env file.

# Backend
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_EXPIRE_HOURS=8
DATABASE_URL=postgresql+psycopg://finanflow:finanflow@localhost:5432/finanflow
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
ENVIRONMENT=development
TZ=America/Sao_Paulo
MAX_UPLOAD_BYTES=2097152
MAX_CSV_ROWS=5000

# Frontend (Vite — used at build time)
VITE_API_URL=
